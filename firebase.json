{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/wdic/events.json",
        "destination": "https://jaychtw.github.io/wdic/events.json",
        "type": 302
      }
    ],
    "predeploy": [
      "npm run build:blog",
      "node scripts/prepare-travel-config.mjs"
    ]
  }
}
